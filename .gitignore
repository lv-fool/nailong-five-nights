*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# 构建产物
*.apk
*.aab
*.unitypackage
*.app

# Unity 崩溃报告
sysinfo.txt
crashlytics-build.properties

# Addressables
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ===== 系统 / 编辑器 =====
.DS_Store
Thumbs.db
desktop.ini
.vs/
.vscode/
.idea/

# ===== 本地临时文件 =====
*.bak
*.orig
*~

# ===== AI 工具本地数据 =====
# 项目记忆与工作日志，属于本地工具数据，不进版本库
.workbuddy-ai/

# ===== 开发工具包（本地嵌入，不进版本库）=====
# MCP for Unity —— 让 AI 直接操作 Unity 编辑器的桥接包。
# 因本机 git 无法直连 GitHub，改用本地嵌入方式安装。
# 换机器时的恢复步骤见 docs/02-开发工具.md
Packages/MCPForUnity/

# Python 脚本跑完留下的字节码缓存
__pycache__/
*.pyc
/build_logs/

# 本机安装/验证用的临时目录（Unity 安装包、测试结果、截图）
/.setup/

# ===== 本地密钥（绝不能提交）=====
.env
.env.local
.env.*.local
*.token
.ghtoken
