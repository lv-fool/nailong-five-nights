# ===== Unity 标准忽略规则 =====
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# 自动生成的工程文件
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# 构建产物
*.apk
*.aab
*.unitypackage
*.app

# Unity 崩溃报告
sysinfo.txt
crashlytics-build.properties

# Addressables
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ===== 系统 / 编辑器 =====
.DS_Store
Thumbs.db
desktop.ini
.vs/
.vscode/
.idea/

# ===== 本地临时文件 =====
*.bak
*.bak.meta
*.orig
*~

# MCP 截图默认落到 Assets/Screenshots/，验证图应存 .workbuddy-ai/screenshots/
/Assets/Screenshots/
/Assets/Screenshots.meta

# ===== AI 工具本地数据 =====
# 项目记忆与工作日志，属于本地工具数据，不进版本库
.workbuddy-ai/

# ===== 开发工具包（本地嵌入，不进版本库）=====
# MCP for Unity —— 让 AI 直接操作 Unity 编辑器的桥接包。
# 因本机 git 无法直连 GitHub，改用本地嵌入方式安装。
# 换机器时的恢复步骤见 docs/02-开发工具.md
Packages/MCPForUnity/

# Python 脚本跑完留下的字节码缓存
__pycache__/
*.pyc
/build_logs/

# 本机安装/验证用的临时目录（Unity 安装包、测试结果、截图）
/.setup/

# 便携版 Blender（约 1.2 GB，装法见 tools/setup_blender.py，随时可重建）
/.tools/

# ===== 本地密钥（绝不能提交）=====
.env
.env.local
.env.*.local
*.token
.ghtoken

# 抠图预览（可再生，见 tools/cutout_naibao.py）
奶包/preview/

# 用户提供的原始模型（47 MB，source 在 奶包/，减面后的产物已入库）
/奶包/*.glb

# 奶包的原始建模（904 MB，别入库）
/奶包/naibaojianmo/

# 讨论用的聊天截图（本地参考，不入库）
/讨论/

# MemSearch 记忆插件的本地索引
/.memsearch/

# 贝利亚跳杀视频：那版是失败品，他的跳杀走图片（char_belial_lunge.png），视频不参与
# 3.4 MB、代码从不加载，且放错在 Assets/Video/ 而真实跳杀视频在 StreamingAssets/
/Assets/Video/Jumpscares/*.mp4
/Assets/Video/Jumpscares/*.mp4.meta
